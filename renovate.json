{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "reviewers": [
    "FournyP"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "github-actions"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "Go module minor/patch updates in one PR.",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go modules non-major"
    },
    {
      "description": "Image minor/patch updates in one PR.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "docker images non-major"
    },
    {
      "description": "Go version moves together everywhere it is pinned; golangci-lint follows since its prebuilt binary panics on a newer Go.",
      "matchDepNames": [
        "go",
        "golang",
        "golangci/golangci-lint"
      ],
      "groupName": "go toolchain"
    }
  ]
}
